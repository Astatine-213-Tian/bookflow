{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "member": {
              "type": "string"
            }
          },
          "required": [
            "member"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "title",
            "children"
          ],
          "additionalProperties": false
        }
      ]
    },
    "chapter": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "role": {
          "enum": [
            "chapter",
            "intro",
            "afterword",
            "extra"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "related_works": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "published_at": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "blocks"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "paragraph",
            "heading",
            "quote",
            "divider"
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "styles": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "bold",
                    "italic",
                    "underline",
                    "strikethrough",
                    "code"
                  ]
                }
              }
            },
            "required": [
              "text",
              "styles"
            ],
            "additionalProperties": false
          }
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "language": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "original",
            "translation"
          ]
        }
      },
      "required": [
        "kind",
        "runs"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "book_id": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "replace_chapter"
                  },
                  "chapter_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "expected_sha256": {
                    "type": "string"
                  },
                  "chapter": {
                    "$ref": "#/$defs/chapter"
                  }
                },
                "required": [
                  "kind",
                  "chapter_id",
                  "expected_sha256",
                  "chapter"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "append_chapter"
                  },
                  "chapter_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "after": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "chapter": {
                    "$ref": "#/$defs/chapter"
                  }
                },
                "required": [
                  "kind",
                  "chapter_id",
                  "after",
                  "chapter"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "append_extra"
                  },
                  "chapter_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "chapter": {
                    "$ref": "#/$defs/chapter"
                  }
                },
                "required": [
                  "kind",
                  "chapter_id",
                  "chapter"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "set_outline"
                  },
                  "expected_sha256": {
                    "type": "string"
                  },
                  "sections": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/node"
                    }
                  }
                },
                "required": [
                  "kind",
                  "expected_sha256",
                  "sections"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "metadata"
                  },
                  "expected_sha256": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "creator": {
                        "type": "string"
                      },
                      "language": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "series": {
                        "type": "string"
                      },
                      "subjects": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "creators": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "series_position": {
                        "type": [
                          "string",
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "kind",
                  "expected_sha256",
                  "fields"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "version",
        "id",
        "book_id",
        "operations"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "const": 3
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "source_format": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "creators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series_position": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "creator",
        "language"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "chapters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/chapter"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "cover": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "mime": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "mime",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "volume_colors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "identifier",
    "metadata",
    "sections",
    "chapters",
    "extras"
  ],
  "additionalProperties": false
}
